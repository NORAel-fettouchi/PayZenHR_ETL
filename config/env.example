# Copie ce fichier en ".env" (ignoré par git) et renseigne les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel.

PAYZEN_SQL_SERVER=localhost
PAYZEN_SQL_PORT=1433
PAYZEN_SQL_DATABASE=PayZenHR_Source
PAYZEN_SQL_USER=sa
PAYZEN_SQL_PASSWORD=change_me
PAYZEN_SQL_ENCRYPT=false
PAYZEN_SQL_TRUST_CERT=true

# Chemin vers le driver JDBC SQL Server (téléchargé une fois, hors du repo git)
PAYZEN_JDBC_JAR_PATH=E:\etape_1\PayZenHR_ETL\jars\mssql-jdbc-13.4.0.jre8.jar
